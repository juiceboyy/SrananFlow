# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Primary high-quality Text-To-Speech engine (Multilingual v2)
# When set, ElevenLabs is used as the primary TTS engine with automatic fallback to Gemini TTS.
ELEVENLABS_API_KEY="MY_ELEVENLABS_API_KEY"

# Optional: Default voice ID for Sranantongo (Default: George / JBFqnCBsd6RMkjVDRZzb or your custom cloned voice ID)
ELEVENLABS_DEFAULT_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

# Optional: Model ID (Default: eleven_multilingual_v2)
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
